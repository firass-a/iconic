logging:
  level: debug
{#  level: error#}

metadata:
  NLAYR: int

data:
### early stopping
  PDI_EARLY_STOPPING: logical
### random seed
  RSEED1: int
### action
  ANFER: float
  AMIR: float
### state
  YRDOY: int
  NSTRES: float
  ISTAGE: int
  GRNWT: float
  TOPWT: float
  PLTPOP: float
  SWFAC: float
  PCNGRN: float
  TLeachD: float
  TNOXD: float
  WTNUP: float
  CLeach: float
  CNOX: float
  CumSumFert: float
  XLAI: float
  TRNU: float
  RAIN: float
  TMIN: float
  TMAX: float
  SRAD: float
  DTT: float
  DAP: int
  ES: float
  RUNOFF: float
  WTDEP: float
  RTDEP: float
  LL:
    type: array
    subtype: float
    size: '$NLAYR'
  DUL:
    type: array
    subtype: float
    size: '$NLAYR'
  DLAYR:
    type: array
    subtype: float
    size: '$NLAYR'
  SW_AVAIL:
    type: array
    subtype: float
    size: '$NLAYR'
  SW:
    type: array
    subtype: float
    size: '$NLAYR'
  DS:
    type: array
    subtype: float
    size: '$NLAYR'
  SAT:
    type: array
    subtype: float
    size: '$NLAYR'
{#  SNO3:#}
{#    type: array#}
{#    subtype: float#}
{#    size: '$NLAYR'#}
{#  SNH4:#}
{#    type: array#}
{#    subtype: float#}
{#    size: '$NLAYR'#}
plugins:
  trace: ~
  pycall:
    on_data:
      YRDOY: |
        yrdoy = YRDOY
      NSTRES: |
        nstres = NSTRES
      ISTAGE: |
        istage = ISTAGE
      GRNWT: |
        grnwt = GRNWT
      TOPWT: |
        topwt = TOPWT
      PLTPOP: |
        pltpop = PLTPOP
      SWFAC: |
        swfac = SWFAC
      PCNGRN: |
        pcngrn = PCNGRN
      TLeachD: |
        tleachd = TLeachD
      TNOXD: |
        tnoxd = TNOXD
      WTNUP: |
        wtnup = WTNUP
      CLeach: |
        cleach = CLeach
      CNOX: |
        cnox = CNOX
      CumSumFert: |
        cumsumfert = CumSumFert
      XLAI: |
        xlai = XLAI
      TRNU: |
        trnu = TRNU
      RAIN: |
        rain = RAIN
      TMIN: |
        tmin = TMIN
      TMAX: |
        tmax = TMAX
      SRAD: |
        srad = SRAD
      DTT: |
        dtt = DTT
      DAP: |
        dap = DAP
      LL: |
        ll = LL
      DUL: |
        dul = DUL
      SW: |
        sw = SW
      SW_AVAIL: |
        sw_avail = SW_AVAIL
      ES: |
        es = ES
      RUNOFF: |
        runoff = RUNOFF
      WTDEP: |
        wtdep = WTDEP
      SAT: |
        sat = SAT
      DLAYR: |
        dlayr = DLAYR
      RTDEP: |
        rtdep = RTDEP
{#      SNO3: |#}
{#        sno3_ini = SNO3#}
{#      SNH4: |#}
{#        snh4_ini = SNH4#}
    on_event:
      start_client:
        exec: |
          import sys
          import zmq
          import json
          import logging
          import numpy as np
          import time
          import faulthandler
          faulthandler.enable()
          class NumpyEncoder(json.JSONEncoder):
            def default(self, obj):
              if isinstance(obj, np.ndarray):
                return obj.tolist()
              return json.JSONEncoder.default(self, obj)
          context = zmq.Context()
          client = context.socket(zmq.PAIR)
          client.setsockopt(zmq.LINGER, 1000)
          poller = zmq.Poller()
          poller.register(client, zmq.POLLIN)
          try:
            client.connect('tcp://localhost:{{ '{0:d}'.format(port) }}')
          except Exception as e:
            print(e)
            logging.exception(e)
            time.sleep(1)
          done = False
          rseed1_ = {{ '{0:d}'.format(rseed1) }}
          print(f'\n~~~~~RSEED1: {rseed1_}~~~~~\n')
          is_early_stopping = False
          is_last_send = False
          print('Client started')
      flag_done:
        exec: |
          done = True
          message = {'done': done, 'state': {}}
          client.send(json.dumps(message, cls=NumpyEncoder).encode('utf-8'))
          is_last_send = True
          rseed1_ = client.recv().decode('utf-8')
          print(f'\n~~~~~RSEED1: {rseed1_}~~~~~\n')
          is_last_send = False
      flag_undone:
        exec: |
          done = False
      stop_client:
        exec: |
          client.close()
          context.term()
          print('Client closed')
      set_rseed:
        with: {rseed1: $RSEED1}
        exec:
          rseed1[()] = rseed1_
      early_stopping:
        with: {pdi_early_stopping: $PDI_EARLY_STOPPING}
        exec:
          pdi_early_stopping.itemset(is_early_stopping)
      interact:
        exec: |
          state = {'yrdoy': yrdoy,
          'nstres': nstres,
          'istage': istage,
          'grnwt': grnwt,
          'topwt': topwt,
          'pltpop': pltpop,
          'swfac': swfac,
          'pcngrn': pcngrn,
          'tleachd': tleachd,
          'tnoxd': tnoxd,
          'wtnup': wtnup,
          'cleach': cleach,
          'cnox': cnox,
          'cumsumfert': cumsumfert,
          'xlai': xlai,
          'trnu': trnu,
          'rain': rain,
          'tmin': tmin,
          'tmax': tmax,
          'srad': srad,
          'dtt': dtt,
          'dap': dap,
          'll': ll,
          'dul': dul,
          'sw': sw,
          'sw_avail': sw_avail,
          'es': es,
          'runoff': runoff,
          'wtdep': wtdep,
          'sat': sat,
          'rtdep': rtdep,
{#          'sno3_ini': sno3_ini,#}
{#          'snh4_ini': snh4_ini,#}
          'dlayr': dlayr
          }
          try:
            message_to_client = {'done':done, 'state':state}
{#            print('before json.dumps', file=sys.stderr, flush=True)#}
{#            for key, val in state.items():#}
{#              print('key ', key, file=sys.stderr, flush=True)#}
{#              print('val ', val, file=sys.stderr, flush=True)#}
            message_to_client_js = json.dumps(message_to_client, cls=NumpyEncoder)
{#            print('after json.dumps', file=sys.stderr, flush=True)#}
          except Exception as e:
{#            print(f'problem: {state} \n', file=sys.stderr)#}
            for key, val in state.items():
              print('key ', key, file=sys.stderr, flush=True)
              print('val ', val, file=sys.stderr, flush=True)
            logging.exception(e)
            time.sleep(1)
          except FloatingPointError as f_:
            print(f_, file=sys.stderr)
            for key, val in state.items():
              print('key ', key, file=sys.stderr, flush=True)
              print('val ', val, file=sys.stderr, flush=True)
            logging.exception(f_)
            time.sleep(1)
          except:
            for key, val in state.items():
              print('key ', key, file=sys.stderr, flush=True)
              print('val ', val, file=sys.stderr, flush=True)
          message_to_client = {'done':None, 'state':None}
          client.send(message_to_client_js.encode('utf-8'))
          is_last_send = True
          try:
            if poller.poll(timeout=1000):
              message_from_client_js = client.recv().decode('utf-8')
            is_last_send = False
            message_from_client = json.loads(message_from_client_js)
            action = message_from_client['action']
            is_early_stopping = message_from_client['early_stopping']
          except Exception as e:
            print('FAILLLLED')
            print(e)
            logging.exception(e)
            time.sleep(1)

      fertilize:
        with: {anfer: $ANFER}
        exec:
          anfer.itemset(action['anfer'])
      irrigate:
        with: {amir: $AMIR}
        exec:
          amir.itemset(action['amir'])