---
logging:
  # level: debug
  level: error
data:
  YRDOY: int
  NSTRES: float
  ISTAGE: int
  ANFER: float
  GRNWT: float
  TOPWT: float
  PLTPOP: float
  SWFAC: float
  PCNGRN: float
  TLeachD: float
  TNOXD: float
  WTNUP: float
  CLeach: float
  CNOX: float
  CumSumFert: float
  XLAI: float
  TRNU: float
plugins:
  pycall:
  trace: ~
    on_data:
      YRDOY: |
        yrdoy = YRDOY
      NSTRES: |
        nstres = NSTRES
      ISTAGE: |
        istage = ISTAGE
      GRNWT: |
        grnwt = GRNWT
      TOPWT: |
        topwt = TOPWT
      PLTPOP: |
        pltpop = PLTPOP
      SWFAC: |
        swfac = SWFAC
      PCNGRN: |
        pcngrn = PCNGRN
      TLeachD: |
        tleachd = TLeachD
      TNOXD: |
        tnoxd = TNOXD
      WTNUP: |
        wtnup = WTNUP
      CLeach: |
        cleach = CLeach
      CNOX: |
        cnox = CNOX
      CumSumFert: |
        cumsumfert = CumSumFert
      XLAI: |
        xlai = XLAI
      TRNU: |
        trnu = TRNU
    on_event:
      start_client:
        exec: |
          try:
            import zmq
            import json
            import logging
            import pdb
            from gym_dssat_pdi.envs.utils.utils import convert
            import numpy as np
            context = zmq.Context()
            print('Starting env client')
            client = context.socket(zmq.PAIR)
            client.setsockopt(zmq.LINGER, 0)
            client.connect('tcp://localhost:{{'{0:d}'.format(port)}}')
            done = False
          except Exception as e:
            logging.exception(e)
      stop_client:
        exec: |
          done = True
          message = {'done': done, 'state': {}}
          client.send(json.dumps(message, default=convert).encode('utf-8'))
          client.close()
          context.term()
          print('Client closed')
      interact:
        with: {anfer: $ANFER}
        exec: |
          try:
            state = {'yrdoy': yrdoy,
                    'nstres': nstres,
                    'istage': istage,
                    'grnwt': grnwt,
                    'topwt': topwt,
                    'pltpop': pltpop,
                    'swfac': swfac,
                    'pcngrn': pcngrn,
                    'tleachd': tleachd,
                    'tnoxd': tnoxd,
                    'wtnup': wtnup,
                    'cleach': cleach,
                    'cnox': cnox,
                    'cumsumfert': cumsumfert,
                    'xlai': xlai,
                    'trnu': trnu}

            message = {'done':done, 'state':state}
            client.send(json.dumps(message, default=convert).encode('utf-8'))
            action = client.recv().decode('utf-8')
            action = json.loads(action)
            anfer[()] = action['anfer']
          except Exception as e:
            logging.exception(e)