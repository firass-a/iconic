  AUG_EPS     ε              0.1
  Hindsight relabeling       True

  total_steps                1,000,000
  warmup_steps               5,000
  buffer_size                200,000
  batch_size                 256
  lr_actor / lr_critic       0.0003 / 0.0003
  gamma                      0.99
  tau                        0.005
  policy_freq                2
  hidden_size                256
  device                     cpu
  model_dir                  /workspace/models/capql_v2_l7afla
